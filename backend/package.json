{
  "name": "jin-nang-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute jin-nang-db --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute jin-nang-db --local --file=seed.sql",
    "db:migrate:local": "wrangler d1 migrations apply jin-nang-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply jin-nang-db --remote"
  },
  "dependencies": {
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.125.0"
  }
}
